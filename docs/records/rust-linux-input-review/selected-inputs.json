            {
              "line": 730,
              "text": "    local _dest_prefix=\"$2\""
            },
            {
              "line": 747,
              "text": "    local _prefix_dir=\"$(abs_path \"$dest_prefix\")\""
            },
            {
              "line": 748,
              "text": "    if [ \"$_src_dir\" = \"$_dest_prefix\" -a \"${CFG_UNINSTALL-}\" != 1 ]; then"
            },
            {
              "line": 787,
              "text": "flag uninstall \"only uninstall from the installation prefix\""
            },
            {
              "line": 788,
              "text": "valopt destdir \"\" \"set installation root\""
            },
            {
              "line": 789,
              "text": "valopt prefix \"/usr/local\" \"set installation prefix\""
            },
            {
              "line": 791,
              "text": "# Avoid prepending an extra / to the prefix path if there's no destdir"
            },
            {
              "line": 801,
              "text": "valopt without \"\" \"comma-separated list of components to not install\""
            },
