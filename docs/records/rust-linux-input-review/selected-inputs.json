            {
              "line": 813,
              "text": "opt ldconfig 1 \"run ldconfig after installation (Linux only)\""
            },
            {
              "line": 851,
              "text": "# which just means 'uninstall my components'."
            },
            {
              "line": 863,
              "text": "dest_prefix=\"$CFG_DESTDIR_PREFIX\""
