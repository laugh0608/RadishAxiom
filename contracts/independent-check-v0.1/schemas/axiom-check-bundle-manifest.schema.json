{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "urn:radishaxiom:schema:axiom-check-bundle-manifest:0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "byte_length": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "content_digest": {
            "$ref": "#/$defs/digest"
          },
          "format": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "format_version": {
            "minLength": 1,
            "type": "string"
          },
          "roles": {
            "items": {
              "enum": [
                "evidence",
                "evidence-artifact",
                "normative-spec",
                "subject"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "byte_length",
          "content_digest",
          "format",
          "format_version",
          "roles"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "bundle_version": {
      "const": "0.1"
    }
  },
  "required": [
    "artifacts",
    "bundle_version"
  ],
  "title": "Axiom Check Bundle Manifest v0.1",
  "type": "object"
}
