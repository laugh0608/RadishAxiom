--- /dev/null
+++ b/cmake/cvc5-c0-inputs.cmake
@@ -0,0 +1,295 @@
+# RadishAxiom private C0 input selection, for one fixed archive candidate.
+# This checks reviewed bytes; it does not establish ABI or tool acceptance.
+include_guard(GLOBAL)
+if(CMAKE_VERSION VERSION_LESS 3.19)
+  message(FATAL_ERROR "C0 requires JSON support (fixed SDK uses CMake 3.25)")
+endif()
+
+function(cvc5_c0_path path)
+  if(NOT IS_ABSOLUTE "${path}" OR NOT "${path}" MATCHES "^/[A-Za-z0-9_./+@=-]+$"
+     OR "${path}" MATCHES "(^|/)\\.\\.?(/|$)" OR "${path}" STREQUAL "/")
+    message(FATAL_ERROR "C0 requires a canonical absolute input path")
+  endif()
+  get_filename_component(real "${path}" REALPATH)
+  if(NOT "${real}" STREQUAL "${path}" OR IS_SYMLINK "${path}" OR NOT EXISTS "${path}")
+    message(FATAL_ERROR "C0 input missing, noncanonical, or symlink: ${path}")
+  endif()
+endfunction()
+
+cvc5_c0_path("${CVC5_C0_INPUT_MANIFEST}")
+file(SIZE "${CVC5_C0_INPUT_MANIFEST}" manifest_size)
+if(manifest_size GREATER 8388608 OR manifest_size EQUAL 0)
+  message(FATAL_ERROR "C0 manifest size rejected")
+endif()
+string(LENGTH "${CVC5_C0_INPUT_MANIFEST_SHA256}" hash_length)
+if(NOT hash_length EQUAL 64 OR NOT CVC5_C0_INPUT_MANIFEST_SHA256 MATCHES "^[0-9a-f]+$")
+  message(FATAL_ERROR "C0 requires the separately reviewed manifest SHA256")
+endif()
+file(SHA256 "${CVC5_C0_INPUT_MANIFEST}" manifest_hash)
+if(NOT manifest_hash STREQUAL CVC5_C0_INPUT_MANIFEST_SHA256)
+  message(FATAL_ERROR "C0 manifest SHA256 mismatch")
+endif()
+file(READ "${CVC5_C0_INPUT_MANIFEST}" CVC5_C0_JSON)
+
+function(cvc5_c0_get out)
+  string(JSON value ERROR_VARIABLE error GET "${CVC5_C0_JSON}" ${ARGN})
+  if(NOT error STREQUAL "NOTFOUND")
+    message(FATAL_ERROR "C0 manifest missing/invalid field: ${ARGN}: ${error}")
+  endif()
+  set(${out} "${value}" PARENT_SCOPE)
+endfunction()
+
+function(cvc5_c0_keys out)
+  string(JSON count ERROR_VARIABLE error LENGTH "${CVC5_C0_JSON}" ${ARGN})
+  if(NOT error STREQUAL "NOTFOUND" OR count EQUAL 0 OR count GREATER 100000)
+    message(FATAL_ERROR "C0 manifest collection rejected: ${ARGN}")
+  endif()
+  math(EXPR last "${count} - 1")
+  set(keys "")
+  foreach(i RANGE 0 ${last})
+    string(JSON key MEMBER "${CVC5_C0_JSON}" ${ARGN} ${i})
+    if(NOT key MATCHES "^[a-z][a-z0-9_]*$")
+      message(FATAL_ERROR "C0 manifest role rejected")
+    endif()
+    list(APPEND keys "${key}")
+  endforeach()
+  list(SORT keys)
+  set(${out} "${keys}" PARENT_SCOPE)
+endfunction()
+
+function(cvc5_c0_file path)
+  cvc5_c0_path("${path}")
+  if(IS_DIRECTORY "${path}")
+    message(FATAL_ERROR "C0 expected a regular file")
+  endif()
+  cvc5_c0_get(expected_size ${ARGN} bytes)
+  cvc5_c0_get(expected_hash ${ARGN} sha256)
+  string(LENGTH "${expected_hash}" hash_length)
+  if(NOT expected_size MATCHES "^[1-9][0-9]*$" OR NOT hash_length EQUAL 64
+     OR NOT expected_hash MATCHES "^[0-9a-f]+$")
+    message(FATAL_ERROR "C0 input requires actual bytes/SHA256")
+  endif()
+  file(SIZE "${path}" actual_size)
+  if(NOT actual_size EQUAL expected_size)
+    message(FATAL_ERROR "C0 input bytes mismatch: ${path}")
+  endif()
+  file(SHA256 "${path}" actual_hash)
+  if(NOT actual_hash STREQUAL expected_hash)
+    message(FATAL_ERROR "C0 input bytes/SHA256 mismatch: ${path}")
+  endif()
+endfunction()
+
+cvc5_c0_get(format format)
+cvc5_c0_get(version version)
+cvc5_c0_get(upstream upstream_commit)
+cvc5_c0_get(target target_abi)
+cvc5_c0_get(review review_state)
+cvc5_c0_keys(root_keys)
+if(NOT root_keys STREQUAL "archives;closure_review;editline_link_order;format;header_roots;review_state;target_abi;upstream_commit;version;versions")
+  message(FATAL_ERROR "C0 manifest has unknown/missing root fields")
+endif()
+if(NOT format STREQUAL "radishaxiom-cvc5-private-build-inputs" OR NOT version STREQUAL "0.1"
+   OR NOT upstream STREQUAL "f3b21c4483d3b88dc63cb7cd3e5eb092eee5e341"
+   OR NOT target STREQUAL "linux-aarch64-le-glibc-gcc12"
+   OR NOT review STREQUAL "reviewed-for-configuration")
+  message(FATAL_ERROR "C0 identity/ABI/closure review is missing or incompatible")
+endif()
+cvc5_c0_get(closure_path closure_review path)
+cvc5_c0_file("${closure_path}" closure_review)
+file(SIZE "${closure_path}" closure_size)
+if(closure_size GREATER 8388608)
+  message(FATAL_ERROR "C0 closure review size rejected")
+endif()
+file(READ "${closure_path}" closure_json)
+string(JSON closure_state GET "${closure_json}" review_state)
+if(NOT closure_state STREQUAL "static-closure-and-abi-reviewed")
+  message(FATAL_ERROR "C0 static closure/ABI review is not complete")
+endif()
+foreach(field IN ITEMS upstream_commit target_abi versions archives header_roots editline_link_order)
+  string(JSON expected ERROR_VARIABLE expected_error GET "${CVC5_C0_JSON}" ${field})
+  string(JSON observed ERROR_VARIABLE observed_error GET "${closure_json}" ${field})
+  if(NOT expected_error STREQUAL "NOTFOUND" OR NOT observed_error STREQUAL "NOTFOUND"
+     OR NOT expected STREQUAL observed)
+    message(FATAL_ERROR "C0 closure review does not bind the actual input field: ${field}")
+  endif()
+endforeach()
+# These are checked assertions of an external package/archive/object review.
+# This helper cannot replace that review or establish tool acceptance itself.
+cvc5_c0_get(gmp_version versions gmp)
+cvc5_c0_get(poly_version versions poly)
+cvc5_c0_get(cadical_version versions cadical)
+cvc5_c0_get(symfpu_version versions symfpu)
+if(NOT gmp_version STREQUAL "6.3.0" OR NOT poly_version STREQUAL "0.2.1"
+   OR NOT cadical_version STREQUAL "rel-2.1.3-elevate"
+   OR NOT symfpu_version STREQUAL "227a7246b8ce513b393cc2645d6d65d3490ea1de")
+  message(FATAL_ERROR "C0 dependency source version mismatch")
+endif()
+
+cvc5_c0_keys(header_roles header_roots)
+if(NOT header_roles STREQUAL "cadical;editline;gmp;gmpxx;poly;symfpu")
+  message(FATAL_ERROR "C0 exact header role set required")
+endif()
+set(CVC5_C0_REQUIRED_gmp gmp.h)
+set(CVC5_C0_REQUIRED_gmpxx gmpxx.h)
+set(CVC5_C0_REQUIRED_cadical cadical/cadical.hpp cadical/tracer.hpp)
+set(CVC5_C0_REQUIRED_poly poly/poly.h poly/version.h)
+set(CVC5_C0_REQUIRED_symfpu symfpu/core/unpackedFloat.h)
+set(CVC5_C0_REQUIRED_editline histedit.h)
+foreach(role IN LISTS header_roles)
+  cvc5_c0_get(root header_roots ${role} path)
+  cvc5_c0_path("${root}")
+  if(NOT IS_DIRECTORY "${root}")
+    message(FATAL_ERROR "C0 header root is not a directory")
+  endif()
+  string(JSON count LENGTH "${CVC5_C0_JSON}" header_roots ${role} files)
+  if(count LESS 1 OR count GREATER 100000)
+    message(FATAL_ERROR "C0 header inventory count rejected")
+  endif()
+  math(EXPR last "${count} - 1")
+  set(expected_files "")
+  foreach(i RANGE 0 ${last})
+    cvc5_c0_get(relative header_roots ${role} files ${i} path)
+    if(IS_ABSOLUTE "${relative}" OR NOT relative MATCHES "^[A-Za-z0-9_./+@=-]+$"
+       OR relative MATCHES "(^|/)\\.\\.?(/|$)" OR relative IN_LIST expected_files)
+      message(FATAL_ERROR "C0 unsafe or duplicate header inventory path")
+    endif()
+    cvc5_c0_file("${root}/${relative}" header_roots ${role} files ${i})
+    list(APPEND expected_files "${relative}")
+  endforeach()
+  foreach(required IN LISTS CVC5_C0_REQUIRED_${role})
+    if(NOT required IN_LIST expected_files)
+      message(FATAL_ERROR "C0 required header missing from reviewed inventory")
+    endif()
+  endforeach()
+  file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/*")
+  set(actual_files "")
+  foreach(relative IN LISTS entries)
+    cvc5_c0_path("${root}/${relative}")
+    if(NOT IS_DIRECTORY "${root}/${relative}")
+      list(APPEND actual_files "${relative}")
+    endif()
+  endforeach()
+  list(SORT expected_files)
+  list(SORT actual_files)
+  if(NOT actual_files STREQUAL expected_files)
+    message(FATAL_ERROR "C0 missing/extra header inventory entry")
+  endif()
+  set(CVC5_C0_HEADER_${role} "${root}")
+endforeach()
+
+cvc5_c0_keys(archive_roles archives)
+foreach(role IN ITEMS gmp gmpxx cadical poly polyxx editline)
+  if(NOT role IN_LIST archive_roles)
+    message(FATAL_ERROR "C0 missing required archive role: ${role}")
+  endif()
+endforeach()
+foreach(role IN LISTS archive_roles)
+  cvc5_c0_get(path archives ${role} path)
+  if(NOT path MATCHES "\\.a$")
+    message(FATAL_ERROR "C0 requires explicit static archives")
+  endif()
+  cvc5_c0_file("${path}" archives ${role})
+  set(CVC5_C0_ARCHIVE_${role} "${path}")
+endforeach()
+string(JSON count LENGTH "${CVC5_C0_JSON}" editline_link_order)
+if(count LESS 1 OR count GREATER 32)
+  message(FATAL_ERROR "C0 reviewed Editline static link closure required")
+endif()
+math(EXPR last "${count} - 1")
+set(CVC5_C0_EDITLINE_ROLES "")
+foreach(i RANGE 0 ${last})
+  cvc5_c0_get(role editline_link_order ${i})
+  if(NOT role MATCHES "^[a-z][a-z0-9_]*$" OR NOT role IN_LIST archive_roles
+     OR role MATCHES "^(gmp|gmpxx|cadical|poly|polyxx)$")
+    message(FATAL_ERROR "C0 Editline closure has an invalid or missing archive")
+  endif()
+  # Repeated archive roles are retained if the reviewed static order needs them.
+  list(APPEND CVC5_C0_EDITLINE_ROLES "${role}")
+endforeach()
+if(NOT "editline" IN_LIST CVC5_C0_EDITLINE_ROLES)
+  message(FATAL_ERROR "C0 Editline link order omits Editline")
+endif()
+set(used_roles ${CVC5_C0_EDITLINE_ROLES} gmp gmpxx cadical poly polyxx)
+list(REMOVE_DUPLICATES used_roles)
+list(SORT used_roles)
+if(NOT used_roles STREQUAL archive_roles)
+  message(FATAL_ERROR "C0 unused/extra archive role")
+endif()
+
+function(cvc5_c0_import target role header_role)
+  add_library(${target} STATIC IMPORTED GLOBAL)
+  set_target_properties(${target} PROPERTIES
+    IMPORTED_LOCATION "${CVC5_C0_ARCHIVE_${role}}"
+    INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${CVC5_C0_HEADER_${header_role}}")
+endfunction()
+
+# These apply before project() and to all subsequent dependency discovery.
+set(CMAKE_FIND_USE_PACKAGE_REGISTRY FALSE)
+set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY FALSE)
+set(CMAKE_FIND_PACKAGE_NO_PACKAGE_REGISTRY TRUE)
+set(CMAKE_FIND_PACKAGE_NO_SYSTEM_PACKAGE_REGISTRY TRUE)
+set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH FALSE)
+set(CMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH FALSE)
+set(CMAKE_FIND_PACKAGE_PREFER_CONFIG FALSE)
+set(CMAKE_DISABLE_FIND_PACKAGE_Git TRUE)
+
+function(cvc5_c0_check_configuration)
+  if(NOT CMAKE_BUILD_TYPE STREQUAL "Production" OR BUILD_SHARED_LIBS OR NOT STATIC_BINARY
+     OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64"
+     OR NOT WASM STREQUAL "OFF")
+    message(FATAL_ERROR "C0 requires the reviewed Production Linux AArch64 static candidate")
+  endif()
+  foreach(option IN ITEMS ENABLE_STATISTICS STATIC_BINARY USE_EDITLINE USE_POLY TREAT_WARNING_AS_ERROR)
+    if(NOT "${${option}}" STREQUAL "ON")
+      message(FATAL_ERROR "C0 requires ON: ${option}")
+    endif()
+  endforeach()
+  foreach(option IN ITEMS ENABLE_ASSERTIONS ENABLE_DEBUG_SYMBOLS ENABLE_TRACING
+      ENABLE_MUZZLE ENABLE_UNIT_TESTING ENABLE_ASAN ENABLE_UBSAN ENABLE_TSAN
+      ENABLE_SAFE_MODE ENABLE_STABLE_MODE ENABLE_VALGRIND ENABLE_IPO
+      ENABLE_AUTO_DOWNLOAD USE_PYTHON_VENV)
+    # In the original three-valued API, IGNORE is false unless ConfigProduction
+    # or a later upstream setter resolves it. Do not rewrite cache values here.
+    if(NOT "${${option}}" STREQUAL "OFF" AND NOT "${${option}}" STREQUAL "IGNORE")
+      message(FATAL_ERROR "C0 requires false (OFF/IGNORE): ${option}")
+    endif()
+  endforeach()
+  foreach(option IN ITEMS BUILD_SHARED_LIBS BUILD_GMP BUILD_CLN ENABLE_GPL
+      ENABLE_CLANG_TIDY ENABLE_COVERAGE ENABLE_PROFILING ENABLE_DEBUG_CONTEXT_MM
+      USE_CLN USE_GLPK USE_COCOA USE_CRYPTOMINISAT USE_KISSAT USE_MPFR
+      NO_GLOBAL_POLY_CTX BUILD_BINDINGS_PYTHON BUILD_BINDINGS_JAVA
+      BUILD_DOCS BUILD_DOCS_GA ONLY_PYTHON_EXT_SRC
+      SKIP_COMPRESS_DEBUG SKIP_SET_RPATH USE_DEFAULT_LINKER)
+    if(NOT "${${option}}" STREQUAL "OFF")
+      message(FATAL_ERROR "C0 requires OFF: ${option}")
+    endif()
+  endforeach()
+  if(NOT CMAKE_C_STANDARD EQUAL 11 OR NOT CMAKE_CXX_STANDARD EQUAL 17)
+    message(FATAL_ERROR "C0 language standard drift")
+  endif()
+  if(CMAKE_C_EXTENSIONS OR CMAKE_CXX_EXTENSIONS)
+    message(FATAL_ERROR "C0 requires the original language extensions OFF")
+  endif()
+  foreach(launcher IN ITEMS CMAKE_C_COMPILER_LAUNCHER CMAKE_CXX_COMPILER_LAUNCHER
+      CMAKE_C_LINKER_LAUNCHER CMAKE_CXX_LINKER_LAUNCHER
+      GLPK_DIR PYTHONIC_PATH PROGRAM_PREFIX WASM_FLAGS)
+    if(NOT "${${launcher}}" STREQUAL "")
+      message(FATAL_ERROR "C0 requires an empty launcher: ${launcher}")
+    endif()
+  endforeach()
+  foreach(flag_variable IN ITEMS CMAKE_C_FLAGS CMAKE_CXX_FLAGS)
+    separate_arguments(flag_tokens UNIX_COMMAND "${${flag_variable}}")
+    if(NOT "-Werror" IN_LIST flag_tokens)
+      message(FATAL_ERROR "C0 requires an exact -Werror token in ${flag_variable}")
+    endif()
+    foreach(token IN LISTS flag_tokens)
+      if(token MATCHES "^-Wno-error" OR token STREQUAL "-w")
+        message(FATAL_ERROR "C0 rejects warning-error overrides in ${flag_variable}")
+      endif()
+    endforeach()
+  endforeach()
+  if(EXISTS "${PROJECT_SOURCE_DIR}/deps/install" OR EXISTS "${PROJECT_BINARY_DIR}/deps"
+     OR CMAKE_PREFIX_PATH OR GLPK_DIR)
+    message(FATAL_ERROR "C0 rejects historical dependency prefixes/cache")
+  endif()
+endfunction()
